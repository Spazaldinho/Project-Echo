// Prisma schema
// WILL LATER BE USED FOR VECTOR DATABASE?

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Information scraped from the users screen
model ScrapedInfo {
  id          Int      @id @default(autoincrement())
  description String
  imagePath   String?
  createdAt   DateTime @default(now())

  @@map("scraped_info")
}
